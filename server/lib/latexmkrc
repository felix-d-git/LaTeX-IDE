# App-owned latexmk rc, loaded after -norc (project rc files stay untrusted, #111).
# glossaries (#139): latexmk only knows makeglossaries through a custom dependency.
# makeindex directly (list form, no shell, no makeglossaries script); $_[0] = base path in -outdir.
add_cus_dep('glo', 'gls', 0, 'lide_glossary');
add_cus_dep('acn', 'acr', 0, 'lide_acronyms');
sub lide_glossary { return system('makeindex', '-s', "$_[0].ist", '-t', "$_[0].glg", '-o', "$_[0].gls", "$_[0].glo"); }
sub lide_acronyms { return system('makeindex', '-s', "$_[0].ist", '-t', "$_[0].alg", '-o', "$_[0].acr", "$_[0].acn"); }
push @generated_exts, 'glo', 'gls', 'glg', 'acn', 'acr', 'alg', 'ist';
