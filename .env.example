# Nach .env kopieren und ausfuellen (.env ist per .gitignore ausgeschlossen).

# Admin-Konto, wird nur beim allerersten Start angelegt (wenn noch keine
# Nutzer existieren). Danach ueber "Passwort vergessen" aenderbar.
ADMIN_EMAIL=felix@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=bitte-ein-echtes-passwort-setzen

# Fester Signier-Schluessel fuer Sessions. Ohne diesen Wert wird bei jedem
# Serverstart ein neuer Zufallswert erzeugt und alle Logins gehen verloren.
# Einmal generieren (z.B. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`)
# und dauerhaft hier eintragen.
SESSION_SECRET=

# Optional: SMTP fuer echten Mailversand (Passwort-Reset-Links). Ohne diese
# Variablen wird der Reset-Link stattdessen in der Konsole und in
# mail-outbox.log ausgegeben (fuer den lokalen Testbetrieb ausreichend).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# Optional: erzwingt "secure"-Cookies (nur ueber HTTPS gesendet) - auf dem Pi
# (Funnel = HTTPS) gesetzt.
# COOKIE_SECURE=true

# Optional: Datenverzeichnis (auth-data.json, .sessions, workspace.json,
# projects/, mail-outbox.log). Standard: Repo-Wurzel.
# DATA_DIR=/app/data

# Nur Pi (docker-compose.pi.yml): Tailscale-Auth-Key (einmalig) und SSD-Pfade.
# TS_AUTHKEY=
# LATEX_DATA_DIR=/srv/latex/data
# LATEX_TEXLIVE_DIR=/srv/latex/texlive

# Optional: feste Basis-URL fuer Einladungs-/Reset-Links, falls der Server
# hinter einer Portweiterleitung/einem anderen Hostnamen als localhost laeuft.
# PUBLIC_URL=https://latex.example.com

PORT=3077
