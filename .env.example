# Nach .env kopieren und ausfuellen (.env ist per .gitignore ausgeschlossen).
# Gilt fuer docker-compose.yml, den lokalen Start (start.bat/start.sh) und den
# Windows-Installer ("Eigener Server" schreibt diese Datei selbst).

# Adresse, unter der der Server erreichbar ist. Steht in Einladungs-/Reset-Links
# und wird in die herunterladbare Desktop-App eingebaut. Ohne: Adresse der Anfrage.
PUBLIC_URL=https://latex.example.com

# Admin-Konto, wird nur beim allerersten Start angelegt (wenn noch keine
# Nutzer existieren). Danach ueber "Passwort vergessen" aenderbar.
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=bitte-ein-echtes-passwort-setzen

# "secure"-Cookies (nur ueber HTTPS gesendet). Auf true setzen, sobald der Server
# per HTTPS (Reverse Proxy, Tailscale Funnel, ...) erreichbar ist.
COOKIE_SECURE=false

# Optional: SMTP fuer echten Mailversand (Einladungen, Passwort-Reset). Ohne diese
# Variablen landen die Links in der Konsole und in mail-outbox.log.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# Optional: Update-Hinweis fuer Admins im Web-UI: off | notify | button | auto
# (Installation per scripts/server-update.sh, siehe README).
# UPDATE_MODE=notify
# Nur solange das GitHub-Repo privat ist: Lese-Token (fine-grained, "Contents: read").
# UPDATE_TOKEN=
# GitHub-Repo (owner/name) fuer Update-Hinweis und Desktop-Downloads.
# UPDATE_REPO=felix-d-git/latex-web-ide

# Optional: Quellcode-Link (/source, Help-Menue, /licenses, MCP). Ohne: Tag dieser
# Version unter https://github.com/<UPDATE_REPO>. Wer veraenderten Code betreibt
# oder weitergibt, MUSS hier den vollstaendigen Quellcode der laufenden Version
# angeben (AGPL-3.0, Abschnitt 13 bzw. 6).
# SOURCE_URL=https://github.com/<owner>/<repo>/tree/<tag>

# Optional: Signier-Schluessel fuer Sessions. Ohne wird einmalig einer erzeugt
# und im Datenordner (.session-secret) gespeichert.
# SESSION_SECRET=

# Nur Docker (docker-compose.yml):
# HOST_PORT=3077
# LATEX_DATA_DIR=./data
# TEXLIVE=apt

# Nur ohne Docker: Datenordner (Standard: Repo-Wurzel; relative Pfade gelten ab der Repo-Wurzel) und Port.
# DATA_DIR=./data
# PORT=3077

# Nur docker-compose.pi.yml (Tailscale Funnel, TeX Live vom Host): Auth-Key (einmalig) und Pfade.
# TS_AUTHKEY=
# LATEX_DATA_DIR=/srv/latex/data
# LATEX_TEXLIVE_DIR=/srv/latex/texlive

# Optional: Daten verschluesselt auf der Platte (at-rest). Beide setzen, sonst aus.
# DATA_DIR ist dann nur Arbeitsverzeichnis (am besten tmpfs/RAM), VAULT_DIR liegt auf
# der Platte und enthaelt nur verschluesselte Dateien. Schluessel erzeugen:
#   node server/lib/vault.js keygen
# Schluessel getrennt von den Daten sichern; ohne ihn sind die Daten unlesbar.
# DATA_KEY=
# VAULT_DIR=./vault
