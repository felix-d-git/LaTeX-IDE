# Nach .env kopieren und ausfuellen (.env ist per .gitignore ausgeschlossen).
# Gilt fuer docker-compose.yml, den lokalen Start (start.bat/start.sh) und den
# Windows-Installer ("Eigener Server" schreibt diese Datei selbst).

# Adresse, unter der der Server erreichbar ist. Steht in Einladungs-/Reset-Links
# und wird in die herunterladbare Desktop-App eingebaut. Ohne: Adresse der Anfrage.
# PUBLIC_URL=https://latex.example.com

# Admin-Konto, wird nur beim allerersten Start angelegt (wenn noch keine
# Nutzer existieren). Danach im Profil oder ueber "Passwort vergessen" aenderbar.
# Leer gelassen: zufaelliges Einmal-Passwort in initial-admin-password.txt im
# Datenordner (mit Verschluesselung in VAULT_DIR), das nach dem ersten Login
# geaendert werden muss.
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# "secure"-Cookies (nur ueber HTTPS gesendet). Auf true setzen, sobald der Server
# per HTTPS (Reverse Proxy, Tailscale Funnel, ...) erreichbar ist.
COOKIE_SECURE=false

# Optional: SMTP fuer echten Mailversand (E-Mail-Bestätigung, Passwort-Reset). Ohne diese
# Variablen landen die Links in der Konsole und in mail-outbox.log.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# Optional: Update-Hinweis fuer Admins im Web-UI: off | notify | button | auto
# (Installation per scripts/server-update.sh, siehe README).
# UPDATE_MODE=notify
# Nur solange das GitHub-Repo privat ist: Lese-Token (fine-grained, "Contents: read").
# UPDATE_TOKEN=
# GitHub-Repo (owner/name) fuer Update-Hinweis und Desktop-Downloads.
# UPDATE_REPO=felix-d-git/LaTeX-IDE

# Optional: Quellcode-Link (/source, Help-Menue, /licenses, MCP, Lizenz-Banner im
# Client). Ohne: laeuft der Server direkt aus einem Git-Checkout (start.sh, start.bat,
# npm start), dessen Commit unter https://github.com/<UPDATE_REPO>/tree/<commit>
# (liegt er nur in einem anderen GitHub-Remote, etwa einem Fork, dort), sonst
# (Docker-Image, Installer) der Link aus dem Client-Build (client/dist/source.json,
# in der Regel der Tag dieser Version). Hat der Checkout lokale Aenderungen oder
# liegt sein Commit auf keinem GitHub-Remote, warnen Server-Log und ein Hinweis
# fuer Admins.
# Wer veraenderten Code betreibt oder weitergibt, MUSS hier den vollstaendigen
# Quellcode der laufenden Version angeben (AGPL-3.0, Abschnitt 13 bzw. 6); ein
# selbst gebautes Docker-Image kennt seinen Git-Stand nicht.
# {version} wird durch die laufende Version ersetzt (folgt Server-Updates).
# SOURCE_URL=https://github.com/<owner>/<repo>/tree/v{version}

# Optional: Signier-Schluessel fuer Sessions. Ohne wird einmalig einer erzeugt
# und im Datenordner (.session-secret) gespeichert.
# SESSION_SECRET=

# Optional: Zeitlimit pro Kompiliervorgang in Millisekunden (Standard 600000 = 10 min).
# Danach wird der TeX-Prozessbaum beendet, z. B. bei einer Endlosschleife im Dokument.
# COMPILE_TIMEOUT_MS=600000

# Optional: Content-Security-Policy nur melden statt durchsetzen (gestufte Einfuehrung).
# Mit 1 blockiert der Browser nichts, meldet Verstoesse aber in seiner Konsole und an den
# Server (Log-Zeilen "[csp] gemeldet: ..."). X-Frame-Options, nosniff und Referrer-Policy
# gelten trotzdem. Ohne Eintrag (Standard) wird die CSP durchgesetzt.
# CSP_REPORT_ONLY=1
# Optional: weitere Ziele, die der Browser direkt abfragen darf (CSP connect-src), mit
# Leerzeichen getrennt, z. B. ein LanguageTool auf einem anderen Rechner ("eigener Rechner"
# in den Einstellungen). localhost und 127.0.0.1 sind immer erlaubt.
# CSP_CONNECT_SRC=https://languagetool.example.com

# Nur Docker (docker-compose.yml):
# HOST_PORT=3077
# LATEX_DATA_DIR=./data
# TEXLIVE=apt

# Nur ohne Docker: Datenordner (Standard: Repo-Wurzel; relative Pfade gelten ab der Repo-Wurzel) und Port.
# DATA_DIR=./data
# PORT=3077

# Nur docker-compose.pi.yml (Tailscale Funnel, TeX Live vom Host): Auth-Key (einmalig) und Pfade.
# TS_AUTHKEY=
# LATEX_DATA_DIR=/srv/latex/data
# LATEX_TEXLIVE_DIR=/srv/latex/texlive

# Optional: Daten verschluesselt auf der Platte (at-rest). Beide setzen, sonst aus.
# DATA_DIR ist dann nur Arbeitsverzeichnis (am besten tmpfs/RAM), VAULT_DIR liegt auf
# der Platte und enthaelt nur verschluesselte Dateien. Schluessel erzeugen:
#   node server/lib/vault.js keygen
# Schluessel getrennt von den Daten sichern; ohne ihn sind die Daten unlesbar.
# Mit Docker gilt das nur fuer docker-compose.pi.yml (tmpfs fuer /app/data, Vault-Volume uid 1000).
# Mit docker-compose.yml fuehrt VAULT_DIR=./vault zur Neustart-Schleife (kein tmpfs, Pfad liegt in
# DATA_DIR): dort VAULT_DIR/DATA_KEY weglassen oder eine Override-Datei mit tmpfs /app/data
# und eigenem Vault-Volume anlegen.
# VAULT_DIR darf nicht in DATA_DIR liegen (und umgekehrt), sonst startet der Server nicht:
# ohne Docker DATA_DIR dann explizit setzen (z. B. DATA_DIR=./data). VAULT_DIR muss beschreibbar sein.
# DATA_KEY=
# VAULT_DIR=./vault

# Weitere optionale Einstellungen (Standard in Klammern):
# LANGUAGETOOL_URL=            # Adresse eines LanguageTool-Servers fuer die Rechtschreibpruefung (aus)
# PANDOC=pandoc                # Pfad zu pandoc (Import/Export), falls nicht im PATH
# TEX_BACKEND=latexmk          # latexmk | tectonic (tectonic nur Desktop-App)
# LOCAL_MODE=0                 # 1 = kein Login, nur 127.0.0.1 (Installer-Option "Lokal")
# LOCAL_IDLE_MS=30000          # LOCAL_MODE: Beenden nach so vielen ms ohne Client
